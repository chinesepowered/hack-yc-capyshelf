# Copy to .env.local and fill in. Never commit real values.
# Server-side only: none of these reach the browser.

# YouCam API (Perfect Corp.) for live skin scans
YOUCAM_API_KEY=

# OpenAI-compatible endpoint for the label reader and explanations (Qwen 3.8 on W&B Inference)
OPENAI_BASE_URL=https://api.inference.wandb.ai/v1
OPENAI_API_KEY=
OPENAI_MODEL=Qwen/Qwen3.8-27B

# Optional: how many live YouCam scans one server process may run (units are shared). Default 5.
LIVE_SCAN_LIMIT=5

# Only for regenerating the demo video narration (scripts/make-video.ts)
ASSEMBLYAI_API_KEY=
